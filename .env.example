# Salin file ini menjadi .env lalu isi sesuai kebutuhan

PORT=3000

# Kunci rahasia untuk JWT (login). Ganti dengan teks acak yang panjang & rahasia.
JWT_SECRET=ganti-dengan-teks-rahasia-yang-panjang-dan-acak

# URL website kamu setelah deploy (dipakai di link reset password pada email)
APP_URL=http://localhost:3000

# Pengaturan email untuk fitur "Lupa Password"
# Contoh pakai Gmail: aktifkan "App Password" di akun Google kamu, JANGAN pakai password akun biasa
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=app-password-gmail-kamu
SMTP_FROM="Depari Shop <emailkamu@gmail.com>"
